=== FILE script.js ===
// Define once...
function greet(name) {
	return "Hello, " + name + "!";
}

// ...call as many times as you like
console.log(greet("Moonbug"));
console.log(greet("Minnow"));

// A function with no return just does something
function shout(text) {
	console.log(text.toUpperCase() + "!!!");
}
shout("i love this cat");

// Several parameters, and a default for the last one
function area(width, height = width) {
	return width * height;
}
console.log("rectangle:", area(4, 3));
console.log("square:", area(4));

// Arrow syntax ~ the same thing, written shorter
const double = (n) => n * 2;
console.log("double:", double(21));

// Variables made inside a function only exist inside it
function counter() {
	let count = 0;
	count = count + 1;
	return count;
}
console.log(counter(), counter());   // 1 1 ~ count starts fresh each time
