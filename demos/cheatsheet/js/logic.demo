=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Conditional logic</title>
	</head>
	<body>
		<h1>Conditional logic</h1>
		<p>Open the console, then change the values in script.js.</p>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
const hour = 14;

// if: do this only when the condition is true
if (hour < 12) {
	console.log("Good morning!");
}

// if...else: one or the other, always
if (hour < 12) {
	console.log("Morning");
} else {
	console.log("Afternoon or later");
}

// else if: as many branches as you need
if (hour < 12) {
	console.log("Morning");
} else if (hour < 18) {
	console.log("Afternoon");
} else {
	console.log("Evening");
}

// Combine conditions with && (and) and || (or)
const raining = true;
const haveUmbrella = false;
if (raining && !haveUmbrella) {
	console.log("Stay inside.");
}

// Values that count as false: 0, "", null, undefined, NaN, false
const nickname = "";
if (nickname) {
	console.log("Hi " + nickname);
} else {
	console.log("No nickname set");
}

// Shorthand for picking between two values
const label = hour < 12 ? "AM" : "PM";
console.log("label:", label);
