<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Variables</title>
	</head>
	<body>
		<h1>Variables</h1>
		<p>Open the console to see what each one holds.</p>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
// let: a value that can change later
let score = 0;
score = score + 10;
console.log("score:", score);

// const: a value that can't be reassigned
const name = "Gabriel";
console.log("name:", name);

// This would throw an error, so it's commented out:
// name = "Somebody else";

// The types you'll actually use
const aNumber = 42;
const someText = "text goes in quotes";
const trueOrFalse = true;
const nothing = null;
const aList = ["Moonbug", "Minnow"];
const anObject = { name: "Moonbug", good: true };

console.log(aNumber, someText, trueOrFalse, nothing);
console.log("list:", aList);
console.log("object:", anObject);

// const stops you REASSIGNING, not editing what's inside
aList.push("Future Cat");
console.log("still works:", aList);
