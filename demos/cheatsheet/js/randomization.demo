=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Randomization</title>
	</head>
	<body>
		<h1 id="fortune">Click the button!</h1>
		<button id="again">Another one</button>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
// Math.random() gives a decimal from 0 up to (but never) 1
console.log(Math.random());

// Scale it to the range you want
console.log("0 to 10:", Math.random() * 10);

// Math.floor rounds down, so this gives a whole number 0-9
console.log("0 to 9:", Math.floor(Math.random() * 10));

// A reusable helper: a whole number from min to max, inclusive
function randomBetween(min, max) {
	return Math.floor(Math.random() * (max - min + 1)) + min;
}
console.log("a dice roll:", randomBetween(1, 6));

// Picking a random item out of a list
const fortunes = [
	"Today is a good day to close some tabs.",
	"You will forget a semicolon. It will be fine.",
	"A cat is thinking about you.",
	"Ship it.",
	"Refactor later. Later never comes. Ship it anyway."
];

function pick(list) {
	return list[Math.floor(Math.random() * list.length)];
}

const heading = document.querySelector("#fortune");
document.querySelector("#again").addEventListener("click", function () {
	heading.textContent = pick(fortunes);
});
