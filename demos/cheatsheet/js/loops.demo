=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Loops</title>
	</head>
	<body>
		<h1>Loops</h1>
		<ul id="list"></ul>
		<p>Open the console too.</p>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
const cats = ["Moonbug", "Minnow", "Future Cat"];

// for...of: go through every item. Start here.
for (const cat of cats) {
	console.log("cat:", cat);
}

// A classic for loop, when you need the position
for (let i = 0; i < cats.length; i++) {
	console.log(i + ": " + cats[i]);
}

// forEach: the same idea, as a method
cats.forEach(function (cat, i) {
	console.log(`#${i + 1} is ${cat}`);
});

// while: repeat until a condition stops being true
let countdown = 3;
while (countdown > 0) {
	console.log(countdown);
	countdown = countdown - 1;
}

// Building HTML with a loop
const list = document.querySelector("#list");
for (const cat of cats) {
	const item = document.createElement("li");
	item.textContent = cat;
	list.append(item);
}

// map: make a NEW list out of an old one
const shouted = cats.map((cat) => cat.toUpperCase());
console.log(shouted);
