=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Adding JavaScript</title>
	</head>
	<body>
		<h1>Open the console below!</h1>
		<p>Everything interesting in this demo is happening down there.</p>

		<!-- A script written straight into the page -->
		<script>
			console.log("Hello from the script element inside index.html!");
		</script>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
// This file is loaded by the <script> tag at the bottom of index.html.
console.log("Hello from script.js!");

// Anything you can do in a <script> element, you can do here.
document.querySelector("h1").style.color = "crimson";
