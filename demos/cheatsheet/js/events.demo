=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Events</title>
	</head>
	<body>
		<h1 id="title">Click things!</h1>
		<button id="colour">Change the colour</button>
		<button id="count">Clicked 0 times</button>

		<p><input id="name" placeholder="Type your name"></p>
		<p id="greeting"></p>

		<ul id="cats">
			<li>Moonbug</li>
			<li>Minnow</li>
			<li>Future Cat</li>
		</ul>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
const title = document.querySelector("#title");

// The pattern: element, event name, function to run
document.querySelector("#colour").addEventListener("click", function () {
	const hue = Math.floor(Math.random() * 360);
	title.style.color = `hsl(${hue} 70% 45%)`;
});

// Remembering something between clicks
let clicks = 0;
const countBtn = document.querySelector("#count");
countBtn.addEventListener("click", () => {
	clicks = clicks + 1;
	countBtn.textContent = `Clicked ${clicks} times`;
});

// Typing fires an event on every keystroke
const nameInput = document.querySelector("#name");
const greeting = document.querySelector("#greeting");
nameInput.addEventListener("input", (event) => {
	greeting.textContent = event.target.value ? `Hi, ${event.target.value}!` : "";
});

// One listener on the parent, instead of one per item
document.querySelector("#cats").addEventListener("click", (event) => {
	if (event.target.tagName === "LI") {
		event.target.style.textDecoration = "line-through";
	}
});
