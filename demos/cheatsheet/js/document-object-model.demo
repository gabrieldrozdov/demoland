=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>The DOM</title>
	</head>
	<body>
		<h1 id="title">The DOM</h1>
		<p class="para">First paragraph.</p>
		<p class="para">Second paragraph.</p>
		<ul id="list">
			<li>An existing item</li>
		</ul>

		<script src="script.js"></script>
	</body>
</html>
=== FILE script.js ===
// Find one element (the first that matches)
const title = document.querySelector("#title");
console.log(title);

// Find all of them
const paras = document.querySelectorAll(".para");
console.log("found", paras.length, "paragraphs");

// Change the text inside an element
title.textContent = "The DOM, edited by JavaScript";

// Change its styles
title.style.color = "crimson";
title.style.fontFamily = "system-ui, sans-serif";

// Add and remove classes ~ usually better than setting styles directly
title.classList.add("edited");

// Read and write attributes
const list = document.querySelector("#list");
list.setAttribute("data-count", "1");
console.log("attribute:", list.getAttribute("data-count"));

// Build a brand new element and put it on the page
const item = document.createElement("li");
item.textContent = "An item made by JavaScript";
list.append(item);

// Loop over everything you found
paras.forEach((p, i) => {
	p.textContent = `Paragraph ${i + 1}, rewritten.`;
});
