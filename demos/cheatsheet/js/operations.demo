=== FILE script.js ===
// Maths
console.log(5 + 3, 5 - 3, 5 * 3, 5 / 3);
console.log("remainder:", 7 % 3);   // what's left over after dividing

// + means something different for text
console.log("Moon" + "bug");
console.log("You have " + 2 + " cats");

// Template literals: much nicer for mixing text and values
const cats = 2;
console.log(`You have ${cats} cats, and ${cats * 2} eyes to feed.`);

// Comparisons give you true or false
console.log(5 > 3, 5 < 3, 5 >= 5);

// Use === and !==, never == and !=
console.log("5 === 5 :", 5 === 5);
console.log("5 === '5' :", 5 === "5");
console.log("5 == '5' :", 5 == "5");   // true, and that's the problem

// Combining conditions
const hungry = true, awake = false;
console.log("and:", hungry && awake);
console.log("or:", hungry || awake);
console.log("not:", !hungry);

// Shorthand you'll see everywhere
let n = 10;
n += 5;   // same as n = n + 5
n++;      // same as n = n + 1
console.log("n:", n);
