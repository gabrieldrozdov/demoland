=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Home</title>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<h1>Home</h1>

		<!-- A link to another page in this demo -->
		<p><a href="about.html">Go to the About page</a></p>

		<!-- A link to a page inside a folder -->
		<p><a href="projects/index.html">Go to the Projects page</a></p>

		<!-- A link to another website -->
		<p><a href="https://gdwithgd.com/">Go to my site</a></p>

		<!-- Open in a new tab -->
		<p><a href="https://gdwithgd.com/" target="_blank" rel="noopener">Open my site in a new tab</a></p>

		<!-- An email link -->
		<p><a href="mailto:gabriel@noreplica.com">Email me</a></p>

		<!-- A link wrapped around something that isn’t text -->
		<p>
			<a href="about.html">
				<img src="https://placehold.co/120x60" alt="A placeholder image linking to the About page">
			</a>
		</p>
	</body>
</html>
=== FILE about.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>About</title>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<h1>About</h1>
		<p>You made it! This is a completely separate HTML file.</p>

		<!-- Back to the file next to this one -->
		<p><a href="index.html">Back home</a></p>

		<!-- Down into a folder -->
		<p><a href="projects/index.html">Over to Projects</a></p>
	</body>
</html>
=== FILE projects/index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Projects</title>
		<link rel="stylesheet" href="../style.css">
	</head>
	<body>
		<h1>Projects</h1>
		<p>This file lives inside a folder called <strong>projects</strong>.</p>

		<!-- ../ means "go up one folder first" -->
		<p><a href="../index.html">Back home</a></p>
		<p><a href="../about.html">Over to About</a></p>
	</body>
</html>
=== FILE style.css ===
body {
	font-family: system-ui, sans-serif;
	line-height: 1.6;
	margin: 24px;
	max-width: 40em;
}

a {
	color: crimson;
	text-underline-offset: 0.2em;
}

a:hover {
	background: #ffe9ee;
}
