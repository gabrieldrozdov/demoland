=== HTML ===
<!-- Images -->
<img src="https://placehold.co/300x150" alt="A grey placeholder box" width="300">

<!-- The same image, but the browser waits until it’s nearly on screen -->
<img src="https://placehold.co/300x150" alt="Another placeholder" width="300" loading="lazy">

<!-- Video -->
<video width="320" controls>
	<source src="video.mp4" type="video/mp4">
	Your browser can’t play this video.
</video>

<!-- Audio -->
<audio controls>
	<source src="song.mp3" type="audio/mpeg">
	Your browser can’t play this audio.
</audio>

<!-- Another site, embedded inside yours -->
<iframe src="https://example.com" width="320" height="200" title="An embedded page"></iframe>

<!-- An image with a caption attached to it -->
<figure>
	<img src="https://placehold.co/300x150" alt="A third placeholder" width="300">
	<figcaption>Moonbug, photographed at her best angle.</figcaption>
</figure>
