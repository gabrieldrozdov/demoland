=== HTML ===
<!-- Headings -->
<h1>Heading 1</h1>
<h2>Heading 2</h2>
<h3>Heading 3</h3>
<h4>Heading 4</h4>
<h5>Heading 5</h5>
<h6>Heading 6</h6>

<!-- Paragraphs -->
<p>
	Paragraphs!
	<br>
	Line breaks!
	<br>
	<strong>Bold text!</strong> <em>Italicized text!</em>
	<br>
	<strong><em>Bold AND italicized text!</em></strong>
</p>

<!-- Lists -->
<ul>
	<li>Unordered (bulleted) lists</li>
	<li>Unordered (bulleted) lists</li>
	<li>Unordered (bulleted) lists</li>
</ul>
<ol>
	<li>Ordered (numbered) lists</li>
	<li>Ordered (numbered) lists</li>
	<li>Ordered (numbered) lists</li>
</ol>

<!-- A few more text elements worth knowing -->
<blockquote>Blockquotes, for quoting somebody.</blockquote>
<p>Inline <code>code</code>, for talking about code inside a sentence.</p>
<pre>Preformatted text,
	which keeps    your spacing
		exactly as you typed it.</pre>
