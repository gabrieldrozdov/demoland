=== HTML ===
<!-- Generic block element -->
<div>Block element</div>
<div>Block element</div>

<!-- Generic inline element -->
<span>Inline element</span>
<span>Inline element</span>

<!-- Examples of block elements -->
<h1>Headings</h1>
<p>Paragraphs</p>
<ul>
	<li>Lists</li>
	<li>Lists</li>
	<li>Lists</li>
</ul>

<!-- Examples of inline elements -->
<a href="#">Links</a>
<strong>Bold text</strong>
<em>Italic text</em>

<!-- Inline elements live inside block elements -->
<p>
	A paragraph is a block, but the <strong>bold bit</strong> and the
	<a href="#">link</a> inside it are inline, so they sit in the flow of the
	sentence instead of breaking it.
</p>

