=== HTML ===
<table>
	<caption>
		Cat Facts
	</caption>

	<thead>
		<tr>
			<th>Name</th>
			<th>Nickname</th>
			<th>Color</th>
			<th>Behavior</th>
		</tr>
	</thead>

	<tbody>
		<tr>
			<th>Moonbug</th>
			<td>Limmie</td>
			<td>Tuxedo</td>
			<td>Good</td>
		</tr>
		<tr>
			<th>Minnow</th>
			<td>Beeki</td>
			<td>Tabby</td>
			<td>Bad</td>
		</tr>
		<tr>
			<th>Future Cat</th>
			<td>???</td>
			<td>Orange</td>
			<td>Chaotic</td>
		</tr>
	</tbody>

	<tfoot>
		<tr>
			<th colspan="3">Best Cat:</th>
			<td>???</td>
		</tr>
	</tfoot>
</table>

