=== HTML ===
<!-- An attribute goes inside the opening tag -->
<a href="https://gdwithgd.com/">A link to my site</a>

<!-- Some elements need an attribute to do anything at all -->
<img src="https://placehold.co/300x150" alt="A grey placeholder box">

<!-- An element can have as many attributes as it needs -->
<a href="https://gdwithgd.com/" target="_blank" title="Opens in a new tab">
	A link that opens in a new tab
</a>

<!-- Some attributes are just switches, with no value -->
<input type="checkbox" checked>
<label>I read the whole cheatsheet</label>

<!-- class and id are the two you’ll use most, once you get to CSS -->
<p class="important" id="the-only-one">
	This paragraph has a class and an id. Neither does anything yet!
</p>
