=== HTML ===
<form>
	<!-- Every input should have a label attached to it -->
	<p>
		<label for="name">Your name</label><br>
		<input type="text" id="name" name="name" placeholder="Gabriel">
	</p>

	<p>
		<label for="email">Your email</label><br>
		<input type="email" id="email" name="email" required>
	</p>

	<!-- Different types get different keyboards and different validation -->
	<p>
		<label for="cats">How many cats do you have?</label><br>
		<input type="number" id="cats" name="cats" min="0" max="99" value="2">
	</p>

	<!-- Radio buttons: pick one. They share a name. -->
	<fieldset>
		<legend>Best cat</legend>
		<label><input type="radio" name="best" value="moonbug" checked> Moonbug</label>
		<label><input type="radio" name="best" value="minnow"> Minnow</label>
	</fieldset>

	<!-- Checkboxes: pick any -->
	<p>
		<label><input type="checkbox" name="newsletter"> Email me about new demos</label>
	</p>

	<!-- A dropdown -->
	<p>
		<label for="hear">How did you find this site?</label><br>
		<select id="hear" name="hear">
			<option value="">Pick one</option>
			<option value="class">A class</option>
			<option value="friend">A friend</option>
			<option value="lost">I am lost</option>
		</select>
	</p>

	<!-- Several lines of text -->
	<p>
		<label for="msg">Anything else?</label><br>
		<textarea id="msg" name="msg" rows="3"></textarea>
	</p>

	<button type="submit">Send</button>
</form>
