=== HTML ===
<style>
	body {
		font-family: Georgia, serif;
		font-size: 1rem;
		line-height: 1.6;
		color: #222;
		max-width: 60ch;
		margin: 16px;
	}

	h1 {
		font-family: system-ui, sans-serif;
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.small-caps {
		font-variant: small-caps;
		letter-spacing: 0.08em;
	}

	.centred { text-align: center; }
	.underlined {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}
	.shouty { text-transform: uppercase; }
</style>

<h1>A heading that is long enough to wrap onto two lines</h1>

<p>
	Body text at a comfortable measure. Sixty characters per line is roughly
	where reading stops being work.
</p>

<p class="small-caps">Small caps, with a little extra letter spacing.</p>
<p class="centred">Centred text.</p>
<p class="underlined">A nicer underline than the default.</p>
<p class="shouty">Uppercased by css, not by typing</p>
