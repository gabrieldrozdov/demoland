=== HTML ===
<style>
	body { font-family: system-ui, sans-serif; margin: 16px; }
	.row > * { background: #d6e9ff; padding: 12px; }
	.row { margin-bottom: 16px; border: 2px dashed #ccc; }

	/* One line, spaced out */
	.basic {
		display: flex;
		gap: 8px;
	}

	/* Push things apart */
	.between {
		display: flex;
		justify-content: space-between;
	}

	/* Line things up on the cross axis */
	.centred {
		display: flex;
		align-items: center;
		height: 100px;
	}

	/* Let one item eat the leftover space */
	.grow > .fills { flex: 1; }

	/* Stack vertically instead */
	.column {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	/* Wrap onto more lines when there isn’t room */
	.wrapping {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.wrapping > * { flex: 1 1 120px; }
</style>

<div class="row basic"><div>one</div><div>two</div><div>three</div></div>
<div class="row between"><div>left</div><div>middle</div><div>right</div></div>
<div class="row centred"><div>tall row</div><div>vertically centred</div></div>
<div class="row basic grow"><div>fixed</div><div class="fills">this one grows</div><div>fixed</div></div>
<div class="row column"><div>stacked</div><div>one</div><div>above another</div></div>
<div class="row wrapping"><div>a</div><div>b</div><div>c</div><div>d</div><div>e</div><div>f</div></div>
