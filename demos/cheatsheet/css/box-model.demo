=== HTML ===
<style>
	* {
		box-sizing: border-box;
	}

	.box {
		width: 250px;
		padding: 20px;
		border: 5px solid crimson;
		margin: 16px;
		background: #eee;
		font-family: sans-serif;
	}

	/* The old behaviour, for comparison */
	.content-box {
		box-sizing: content-box;
		border-color: navy;
	}
</style>

<div class="box">
	border-box: 250px wide including padding and border.
</div>

<div class="box content-box">
	content-box: 250px of content, PLUS padding and border, so 300px on screen.
</div>
