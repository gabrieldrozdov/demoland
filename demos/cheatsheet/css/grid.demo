=== HTML ===
<style>
	body { font-family: system-ui, sans-serif; margin: 16px; }
	.grid { display: grid; gap: 8px; margin-bottom: 16px; border: 2px dashed #ccc; }
	.grid > * { background: #ffd9a0; padding: 12px; }

	/* Three equal columns */
	.thirds {
		grid-template-columns: 1fr 1fr 1fr;
	}

	/* Columns of different sizes */
	.sidebar {
		grid-template-columns: 200px 1fr;
	}

	/* As many columns as fit, each at least 120px */
	.responsive {
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
	}

	/* Items can span more than one cell */
	.spanning {
		grid-template-columns: repeat(4, 1fr);
	}
	.spanning .wide { grid-column: span 2; }
	.spanning .tall { grid-row: span 2; }
</style>

<div class="grid thirds"><div>1</div><div>2</div><div>3</div></div>

<div class="grid sidebar"><div>200px sidebar</div><div>the rest</div></div>

<div class="grid responsive">
	<div>a</div><div>b</div><div>c</div><div>d</div><div>e</div><div>f</div>
</div>

<div class="grid spanning">
	<div class="wide">spans 2 columns</div><div>b</div><div class="tall">spans 2 rows</div>
	<div>d</div><div>e</div>
</div>
