=== HTML ===
<style>
	body { font-family: sans-serif; }
	div { padding: 12px; margin-bottom: 6px; color: white; }

	/* Named colours ~ 148 of them */
	.named { background: rebeccapurple; }

	/* Hex ~ red, green, blue in base 16 */
	.hex { background: #663399; }
	.hex-short { background: #639; }        /* same colour, shorthand */
	.hex-alpha { background: #66339980; }   /* last pair is transparency */

	/* rgb ~ 0 to 255 per channel */
	.rgb { background: rgb(102 51 153); }
	.rgba { background: rgb(102 51 153 / 50%); }

	/* hsl ~ hue, saturation, lightness. Easier to adjust by hand. */
	.hsl { background: hsl(270 50% 40%); }
	.hsl-light { background: hsl(270 50% 65%); }

	/* Define a colour once, reuse it everywhere */
	:root {
		--brand: hsl(270 50% 40%);
	}
	.var { background: var(--brand); }
</style>

<div class="named">rebeccapurple ~ a named colour</div>
<div class="hex">#663399</div>
<div class="hex-short">#639 ~ the same thing, shorter</div>
<div class="hex-alpha">#66339980 ~ 50% transparent</div>
<div class="rgb">rgb(102 51 153)</div>
<div class="rgba">rgb(102 51 153 / 50%)</div>
<div class="hsl">hsl(270 50% 40%)</div>
<div class="hsl-light">hsl(270 50% 65%) ~ same hue, lighter</div>
<div class="var">var(--brand)</div>
