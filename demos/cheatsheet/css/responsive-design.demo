=== HTML ===
<style>
	* { box-sizing: border-box; }
	body { font-family: system-ui, sans-serif; margin: 0; }

	/* Write the small-screen version first, with no query */
	.layout {
		display: grid;
		gap: 12px;
		padding: 12px;
	}
	.panel { background: #d6e9ff; padding: 16px; }
	.note::after { content: " (narrow layout)"; }

	/* Then add columns once there is room */
	@media (min-width: 600px) {
		.layout {
			grid-template-columns: 200px 1fr;
		}
		.note::after { content: " (wide layout)"; }
	}

	/* Queries can ask about more than width */
	@media (prefers-color-scheme: dark) {
		body { background: #1a1a1a; color: #fafafa; }
		.panel { background: #333; }
	}

	/* Often you don’t need a query at all */
	.cards {
		display: grid;
		gap: 12px;
		padding: 12px;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
	}
	.cards > * { background: #ffd9a0; padding: 16px; }
</style>

<div class="layout">
	<div class="panel note">Sidebar</div>
	<div class="panel">Main content. Drag the divider between the code and preview panels to resize me!</div>
</div>

<div class="cards">
	<div>no media query</div><div>needed</div><div>at all</div><div>for this</div>
</div>
