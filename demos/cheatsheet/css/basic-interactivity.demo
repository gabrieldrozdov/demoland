=== HTML ===
<style>
	body { font-family: system-ui, sans-serif; margin: 16px; }

	.btn {
		display: inline-block;
		padding: 10px 18px;
		border: 2px solid crimson;
		border-radius: 8px;
		background: white;
		color: crimson;
		text-decoration: none;
		/* Animate between the states instead of snapping */
		transition: background 0.15s, color 0.15s;
	}

	/* Pointer is over it */
	.btn:hover {
		background: crimson;
		color: white;
	}

	/* Mouse button is held down */
	.btn:active {
		transform: translateY(2px);
	}

	/* Reached by keyboard ~ do not remove this */
	.btn:focus-visible {
		outline: 3px solid navy;
		outline-offset: 2px;
	}

	/* Works on anything, not just buttons */
	.card {
		padding: 16px;
		margin-top: 16px;
		background: #eee;
		transition: box-shadow 0.2s;
	}
	.card:hover {
		box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
	}
</style>

<a href="#" class="btn">Hover me, click me, or press Tab to me</a>

<div class="card">A card that lifts on hover.</div>
