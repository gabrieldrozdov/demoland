=== HTML ===
<style>
	/* Selects every <p> element */
	p {
		line-height: 1.5;
	}

	/* Selects any element with class="callout" */
	.callout {
		border-left: 4px solid crimson;
		padding-left: 12px;
	}

	/* Selects the one element with id="hero" */
	#hero {
		font-size: 2rem;
	}

	/* An element can have several classes at once */
	.rounded {
		border-radius: 12px;
	}
	.boxed {
		background: #eee;
		padding: 12px;
	}

	/* Only <p> elements that also have class="callout" */
	p.callout {
		font-style: italic;
	}
</style>

<p id="hero">A paragraph with an id.</p>
<p>An ordinary paragraph.</p>
<p class="callout">A paragraph with the callout class.</p>
<div class="boxed rounded">A div with two classes.</div>
