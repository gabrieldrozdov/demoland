=== HTML ===
<style>
	p {
		color: navy;
	}
</style>

<p>This paragraph follows the stylesheet and comes out navy.</p>

<!-- An inline style beats the stylesheet above -->
<p style="color: crimson">This one is overridden inline.</p>

<!-- Several declarations, separated by semicolons -->
<p style="color: green; font-weight: bold; letter-spacing: 0.1em">
	Several inline declarations at once.
</p>

<!-- The one job inline styles are genuinely good at -->
<div style="--brand: hotpink">
	<p style="color: var(--brand)">A one-off value, passed in from the markup.</p>
</div>
