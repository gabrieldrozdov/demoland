=== HTML ===
<style>
	body { font-family: system-ui, sans-serif; margin: 16px; }
	.box { width: 60px; height: 60px; background: crimson; margin-bottom: 16px; }

	/* Define the steps */
	@keyframes slide {
		from { transform: translateX(0); }
		to   { transform: translateX(200px); }
	}

	/* Attach them to an element */
	.slide {
		animation: slide 1.5s ease-in-out infinite alternate;
	}

	/* More than two steps */
	@keyframes pulse {
		0%   { transform: scale(1);   background: crimson; }
		50%  { transform: scale(1.4); background: hotpink; }
		100% { transform: scale(1);   background: crimson; }
	}
	.pulse {
		animation: pulse 1.2s ease-in-out infinite;
	}

	/* Respect people who asked for less motion */
	@media (prefers-reduced-motion: reduce) {
		.slide, .pulse { animation: none; }
	}
</style>

<p>Sliding:</p>
<div class="box slide"></div>

<p>Pulsing:</p>
<div class="box pulse"></div>
