=== HTML ===
<style>
	body {
		font-family: sans-serif;
		background-color: #fafafa;
	}
	h1 {
		color: crimson;
	}
</style>

<h1>Styled by the block above</h1>
<p>Every rule in that &lt;style&gt; element applies to this page.</p>
