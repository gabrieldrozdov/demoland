=== HTML ===
<style>
	:root { font-size: 16px; }
	body { font-family: sans-serif; }
	div { background: #eee; margin-bottom: 8px; padding: 8px; }

	/* Absolute: always the same size */
	.px { width: 200px; }

	/* Relative to font size */
	.rem { width: 12rem; }   /* 12 x the root font size */
	.em  { width: 12em; font-size: 12px; }  /* 12 x THIS element's font size */

	/* Relative to the parent */
	.pct { width: 50%; }

	/* Relative to the window */
	.vw { width: 50vw; }
	.vh { height: 20vh; }

	/* Let the browser do arithmetic */
	.calc { width: calc(100% - 40px); }

	/* Pick a size, but keep it within limits */
	.clamp { width: clamp(150px, 50%, 400px); }
</style>

<div class="px">200px ~ always 200px</div>
<div class="rem">12rem ~ 12 x the root font size (192px)</div>
<div class="em">12em ~ 12 x this element’s own 12px font (144px)</div>
<div class="pct">50% ~ half the parent</div>
<div class="vw">50vw ~ half the window width</div>
<div class="vh">20vh tall ~ a fifth of the window height</div>
<div class="calc">calc(100% - 40px)</div>
<div class="clamp">clamp(150px, 50%, 400px) ~ resize the preview!</div>
