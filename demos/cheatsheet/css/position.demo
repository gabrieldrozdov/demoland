=== HTML ===
<style>
	* { box-sizing: border-box; }
	body { font-family: sans-serif; margin: 0; padding: 16px 16px 120px; }
	.box { padding: 12px; margin-bottom: 12px; background: #ddd; }

	/* static: the default. Top/left/right/bottom do nothing. */
	.static { position: static; }

	/* relative: nudged from where it would have been, but its space is kept */
	.relative {
		position: relative;
		left: 40px;
		background: #ffd9a0;
	}

	/* absolute: positioned against the nearest positioned ancestor */
	.parent {
		position: relative;
		height: 120px;
		background: #d6e9ff;
	}
	.absolute {
		position: absolute;
		bottom: 8px;
		right: 8px;
		margin: 0;
		background: #a0c4ff;
	}

	/* fixed: pinned to the window, ignores scrolling entirely */
	.fixed {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		margin: 0;
		background: crimson;
		color: white;
	}
</style>

<div class="box static">static ~ normal flow</div>
<div class="box relative">relative ~ shoved 40px right, but its old space is still reserved</div>

<div class="box parent">
	relative parent
	<div class="box absolute">absolute ~ bottom right of the parent</div>
</div>

<div class="box">Another normal box.</div>
<div class="box fixed">fixed ~ pinned to the window, try scrolling</div>
