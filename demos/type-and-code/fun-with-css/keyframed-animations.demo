=== FILE index.html ===
<link rel="stylesheet" href="style.css">

<div class="test-animation">A</div>
=== FILE style.css ===
/* import the font */
@font-face {
	font-family: "Example";
	src: url("ExampleVariableComponentVF.ttf") format("truetype");
}

/* style the class */
.test-animation {
	font-family: "Example";
	font-size: 200px;
	font-variation-settings: "TRAN" 0;

	/* properties for animations */
	animation-name: example-animation;
	animation-duration: 1s;
	animation-iteration-count: infinite;
	animation-timing-function: ease-in-out;
	animation-direction: alternate;
}

/* define the animation */
@keyframes example-animation {
	0% {
		font-variation-settings: "TRAN" 0;
	}
	25% {
		font-variation-settings: "TRAN" 100;
	}
	50% {
		font-variation-settings: "TRAN" 80;
		color: blue;
	}
	75% {
		font-variation-settings: "TRAN" 100;
	}
	100% {
		font-variation-settings: "TRAN" 0;
		color: red;
	}
}
