=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
.test-element {
	transform: rotate(3deg);
	background-color: yellow;
	padding: 5px;
	border: 5px solid blue;
	margin: 10px;
	line-height: 2em;
	display: block;
	/* display: inline; */
	/* display: inline-block; */
}
