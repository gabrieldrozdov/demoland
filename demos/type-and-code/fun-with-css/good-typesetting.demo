=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	/* border: 1px solid black; */
}

.container {
	max-width: 480px;
	width: 100%;
	margin: 0 auto;
	font-size: 18px;
	font-family: sans-serif;
	padding: 40px;
}

.container h1 {
	font-size: 24px;
	line-height: 1.2em;
	margin-bottom: 20px;
}

.container p {
	line-height: 1.2em;
	margin-bottom: 20px;
	color: #222222;
}
