=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

.test-margin {
	padding: 40px;
	border: 10px solid black;
	background-color: yellow;
	border-radius: 20px;
	margin: 20px;
}
