=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
body {
	font-family: sans-serif;
}

/* Navbar */
.nav {
	display: flex;
	margin: 10px;
	border: 1px solid black;
	padding: 20px;
	gap: 10px;
}
.nav-spacer {
	flex-grow: 1;
}
.nav-link {
	color: blue;
	text-decoration: none;
}

/* Header */
.header {
	padding: 40px;
	min-height: 320px;
	border: 1px solid black;
	margin: 10px;
	display: flex;
	flex-direction: column;
	gap: 20px;
	align-items: center;
	justify-content: center;
	text-align: center;
}
.header-link {
	border: 1px solid black;
	padding: 10px;
	color: black;
	text-decoration: none;
}
.header-link:hover {
	background-color: black;
	color: white;
}

/* Projects */
.projects {
	margin: 10px;
	display: grid;
	grid-template-columns: 1fr 1fr 1fr;
	gap: 20px;
}
.project-link {
	color: black;
	border: 1px solid black;
	text-decoration: none;
	display: flex;
	flex-direction: column;
	gap: 10px;
	padding: 10px;
}
.project-link img {
	width: 100%;
}
.project-link h2 {
	font-size: 24px;
}
.project-link p {
	font-size: 18px;
}

/* Mobile styles */
@media (max-width: 600px) {
	.projects {
		grid-template-columns: 1fr 1fr;
	}
}
@media (max-width: 400px) {
	.projects {
		grid-template-columns: 1fr;
	}
}
