=== FILE index.html ===
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>This is a website</title>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>

		<div class="nav">
			<a href="#">A link</a>
			<div class="spacer"></div>
			<a href="#">A link</a>
