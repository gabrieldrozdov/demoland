=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
body {
	font-family: sans-serif;
}
.nav {
	display: flex;
	padding: 20px;
	margin: 20px;
	border: 1px solid black;
	gap: 10px;
}
.spacer {
	flex-grow: 1;
}
