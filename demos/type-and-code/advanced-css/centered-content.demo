=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
body {
	font-family: sans-serif;
}
.container {
	height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
}
