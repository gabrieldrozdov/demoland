=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
body {
	font-family: sans-serif;
}
.container {
	margin: 0 auto;
	max-width: 400px;
	padding: 40px;
	display: flex;
	flex-direction: column;
	gap: 20px;
}
