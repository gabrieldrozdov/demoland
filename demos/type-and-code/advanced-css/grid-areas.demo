=== FILE style.css ===
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
body {
	font-family: sans-serif;
}

.parent {
	display: grid;
	grid-template-areas:
		"a a a"
		  "b c c"
		  "b c c";
	height: 100vh;
}

.parent > * {
	border: 5px solid black;
	font-size: 24px;
	border-radius: 10px;
	margin: 2px;
	padding: 5px;
}

.first-area {
	grid-area: a;
}

.second-area {
	grid-area: b;
}

.third-area {
	grid-area: c;
}
