=== FILE style.css ===
body {
	background-color: yellow;
}
p {
	font-size: 24px;
	color: rgb(255,0,100);
	letter-spacing: .5em;
	word-spacing: 2ch;
	text-shadow: 10px 10px 5px green;
	text-transform: uppercase;
	font-weight: bold;
	text-align: right;
	line-height: 2em;
}
