=== FILE style.css ===
/* least specific */
body {
	font-family: sans-serif;
	font-size: 10px;
}

/* more specific: a child of the body */
div {
	font-family: monospace;
	font-size: 24px;
}

/* more specific: a class */
.example {
	font-family: cursive;
	font-size: 36px;
}
