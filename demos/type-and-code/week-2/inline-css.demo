=== FILE index.html ===
<link rel="stylesheet" href="style.css">

<h1>
	G’morning y’all. Howdy pardner.
</h1>

<p>
	And a-howdy to you too, pardner.
</p>

<!-- inline css with 1 property -->

<p style="color: blue;">
	And hellooooooooo to the rest of ya!
</p>

<!-- inline css with multiple properties -->

<p style="color: blue; font-size: 40px;">
	And hellooooooooo to the rest of ya!
</p>
=== FILE style.css ===
h1 {
	font-family: sans-serif;
}

p {
	font-size: 24px;
	color: red;
	letter-spacing: 2px;
}

=== CONFIG ===
{
	"allowAdd": true
}